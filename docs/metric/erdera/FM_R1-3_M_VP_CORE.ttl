<https://w3id.org/fair-metrics/erdera/FM_R1-3_M_VP_CORE>
    a                          ftr:Metric, dcat:Dataset ;
    rdfs:isDefinedBy            <https://fairmetrics.github.io/Metrics/metric/erdera/FM_R1-3_M_VP_CORE.ttl> ;

    ftr:identifier            "https://w3id.org/fair-metrics/erdera/FM_R1-3_M_VP_CORE"^^xsd:anyURI ;
    dcterms:title             "ERDERA Metric - R1.3 - Metadata - Quality Control for Virtual Platform Onboarding" ;
    vivo:abbreviation         "FM_R1-3_M_VP_CORE" ;
    dcat:landingPage          <https://w3id.org/fair-metrics/erdera/FM_R1-3_M_VP_CORE> ;

    dcterms:description       """The ERDERA Project has strict requirements for minimal 
    metadata to onboard their Virtual Platform. 
    This metric evaluates whether the metadata provided for a Virtual Platform 
    meets the ERDERA expectations for a 'useful' metadata record.  
    These include a title with at least 4 words, and a description with at least 200 characters.""";
    dcat:keyword              "FAIR", "R1.3", "identifier", "metadata", "ERDERA", "virtual platform"   ;

    dcat:landingPage          <https://w3id.org/fair-metrics/erdera/FM_R1-3_M_VP_CORE> ;


    dcat:contactPoint           [
        a                     vcard:Individual ;
        vcard:fn              "Mark D. Wilkinson" ;
        vcard:organization-name "Wilkinson Laboratory, UPM, Madrid";
        vcard:hasEmail             <mailto:mark.wilkinson@upm.es> ;
    ] ;
	ftr:status "Active"@en ;
    dcterms:issued            "2026-11-21"^^xsd:date ;
    dcterms:modified          "2026-11-21"^^xsd:date ;

    dcat:version              "Champion1.0" ;

