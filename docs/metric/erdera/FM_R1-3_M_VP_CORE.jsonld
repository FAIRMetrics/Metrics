      },
      "dc:title": "ERDERA Metric - R1.3 - Metadata - Quality Control for Virtual Platform Onboarding",
      "http://vivoweb.org/ontology/core#abbreviation": "FM_R1-3_M_VP_CORE",
      "dcat:landingPage": {
        "@id": "https://w3id.org/fair-metrics/erdera/FM_R1-3_M_VP_CORE"
      },
      "dc:description": "The ERDERA Project has strict requirements for minimal \n    metadata to onboard their Virtual Platform. \n    This metric evaluates whether the metadata provided for a Virtual Platform \n    meets the ERDERA expectations for a 'useful' metadata record.  \n    These include a title with at least 4 words, and a description with at least 200 characters.",
      "dcat:keyword": [
        "FAIR",
        "R1.3",
        "identifier",
        "metadata",
        "ERDERA",
        "virtual platform"
      ],
