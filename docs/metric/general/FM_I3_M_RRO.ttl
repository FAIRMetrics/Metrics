<https://w3id.org/fair-metrics/general/FM_I3_M_RRO>
    a                          ftr:Metric, dcat:Dataset ;
    rdfs:isDefinedBy            <https://fairmetrics.github.io/Metrics/metric/general/FM_I3_M_RRO.ttl> ;

    ftr:identifier            "https://w3id.org/fair-metrics/general/FM_I3_M_RRO"^^xsd:anyURI ;
    dcterms:title             "FAIR Metric - I3 - Metadata - Contains Qualified Links to Related Research Objects" ;
    vivo:abbreviation         "FM_I3_M_RRO" ;
    dcat:landingPage          <https://w3id.org/fair-metrics/general/FM_I3_M_RRO> ;

    dcterms:description       """<p>This metric evaluates whether there are qualified (labelled or named) 
    links in the metadata that reference other research objects; 
        notably, unlike the FM_I3_M_QualRef Metric, this metrics, does NOT reqiure that 
        referencd IRIs are in a different domain than the provided identifie, allowing cross-references
        between related local records to be acceptable to pass this metric</p>

<p>I3 requires that metadata include qualified references to other metadata. 
The purpose of this principle is to ensure that digital objects are connected to the wider 
research ecosystem through explicitly defined and semantically meaningful relationships. 
""";
    dcat:keyword              "FAIR", "I3", "identifier", "metadata" ;

    dcat:landingPage          <https://w3id.org/fair-metrics/general/FM_I3_M_RRO> ;
    dqv:inDimension <https://doi.org/10.25504/FAIRsharing.ae22b8> ;


    dcat:contactPoint           [
